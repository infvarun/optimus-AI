{
  "name": "optimus-harness",
  "version": "0.1.0",
  "private": true,
  "description": "Optimus harness: Copilot SDK (BYOK) agent backend for enterprise application support and operations.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "mock-llm": "tsx scripts/mock-openai.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@github/copilot-sdk": "^1.0.34",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.7",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
