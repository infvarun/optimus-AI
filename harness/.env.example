# ---- Model provider (BYOK) -------------------------------------------------
# REQUIRED. One of: ollama | openai | azure | anthropic | google
# Default here is Ollama on this machine. Change it when moving to Azure / an
# internal gateway (see README "Providers").
LLM_PROVIDER_TYPE=ollama
# Ollama: optional, defaults to http://localhost:11434/v1
# Azure OpenAI: https://<resource>.openai.azure.com   (host only, no path)
# OpenAI-compatible gateway (LiteLLM, internal, Bedrock via gateway): https://<gateway>/v1  with type=openai
LLM_BASE_URL=
# Model name. For Ollama it must be a model you've pulled AND that supports tool calling and,
# ideally, thinking. qwen3 is the best fit we know of: qwen3:8b (~6 GB) runs on most laptops,
# qwen3:14b (~10 GB) should plan and recover from errors better if you have the memory.
# For Azure it's the deployment name.
LLM_MODEL=qwen3:8b
# Context window the model server really uses. For Ollama this must match OLLAMA_CONTEXT_LENGTH
# (defaults to 16384 for ollama). The runtime compacts older context before reaching it.
LLM_CONTEXT_TOKENS=
LLM_MAX_OUTPUT_TOKENS=4096
# Credentials: set ONE (not needed for Ollama). Bearer token wins if both are set.
LLM_API_KEY=
LLM_BEARER_TOKEN=
# Optional: openai/azure only. completions (default) | responses
LLM_WIRE_API=
# Optional: azure only. Omit to use the GA versionless v1 route.
AZURE_OPENAI_API_VERSION=

# ---- Agent loop guards (per user message) ---------------------------------
# Max tool calls before the run is stopped.
AGENT_MAX_TOOL_CALLS=30
# Times the agent is nudged to keep going if it stops without submit_resolution.
AGENT_MAX_CONTINUES=2
# Wall-clock limit. Local models are slow; 15 minutes is generous for qwen3:8b.
AGENT_TURN_TIMEOUT_SECONDS=900

# ---- Harness ---------------------------------------------------------------
HOST=127.0.0.1
PORT=8787
# Shared bearer token for /api/*. Placeholder only; use SSO/OIDC in production.
HARNESS_API_TOKEN=
MAX_SESSIONS=50
SESSION_IDLE_MINUTES=30
# Where the Copilot runtime keeps session state (relative to where you start the server).
HARNESS_DATA_DIR=.optimus-data
# Comma-separated browser origins allowed to call the API directly (e.g. the Vite dev server).
CORS_ORIGINS=http://localhost:5173
