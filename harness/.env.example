# ---- Model provider (BYOK) -------------------------------------------------
# REQUIRED. One of: ollama | openai | azure | anthropic | google
# Default here is Ollama on this machine. Change it when moving to Azure / an
# internal gateway (see README "Providers").
LLM_PROVIDER_TYPE=ollama
# Ollama: optional, defaults to http://localhost:11434/v1
# Azure OpenAI: https://<resource>.openai.azure.com   (host only, no path)
# OpenAI-compatible gateway (LiteLLM, internal, Bedrock via gateway): https://<gateway>/v1  with type=openai
LLM_BASE_URL=
# Model name. For Ollama it must be a model you've pulled AND that supports tool calling,
# e.g. qwen3:8b, qwen2.5:7b, llama3.1:8b. For Azure it's the deployment name.
LLM_MODEL=qwen3:8b
# Credentials: set ONE (not needed for Ollama). Bearer token wins if both are set.
LLM_API_KEY=
LLM_BEARER_TOKEN=
# Optional: openai/azure only. completions (default) | responses
LLM_WIRE_API=
# Optional: azure only. Omit to use the GA versionless v1 route.
AZURE_OPENAI_API_VERSION=

# ---- Harness ---------------------------------------------------------------
HOST=127.0.0.1
PORT=8787
# Shared bearer token for /api/*. Placeholder only; use SSO/OIDC in production.
HARNESS_API_TOKEN=
MAX_SESSIONS=50
SESSION_IDLE_MINUTES=30
# Where the Copilot runtime keeps session state (relative to where you start the server).
HARNESS_DATA_DIR=.optimus-data
# Comma-separated browser origins allowed to call the API directly (e.g. the Vite dev server).
CORS_ORIGINS=http://localhost:5173
